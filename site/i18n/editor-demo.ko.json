  "patterns": [
    {
      "source": "^Editor A ↔ Editor B · Cube X (?<value>[-.0-9]+) · (?<owner>.+)$",
      "template": "Editor A ↔ Editor B · Cube X {value} · {owner}",
      "mapGroups": {
        "owner": "mirrorOwner"
      }
    },
    {
      "source": "^Locked · (?<editor>[AB])$",
      "template": "잠김 · {editor}"
    },
    {
      "source": "^Owner · Editor (?<editor>[AB])$",
      "template": "소유자 · Editor {editor}"
    },
    {
      "source": "^Type · (?<type>.+)$",
      "template": "타입 · {type}"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · [^·]+)?) handles · Global$",
      "template": "{editor} 핸들 · 글로벌"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · [^·]+)?) handles · Local$",
      "template": "{editor} 핸들 · 로컬"
    },
    {
      "source": "^(?<name>.+) Transform mirrored from (?<editor>Editor [AB](?: · .+)?)$",
      "template": "{name} Transform이 {editor}에서 동기화됨"
    },
    {
      "source": "^(?<name>.+) (?<property>position|rotation|scale) edited in (?<editor>Editor [AB](?: · .+)?)$",
      "template": "{name} {property}를 {editor}에서 편집함",
      "mapGroups": {
        "property": "property"
      }
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) selected (?<name>.+)$",
      "template": "{editor}에서 {name} 선택됨"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) cleared selection$",
      "template": "{editor} Selection 해제됨"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) · View tool$",
      "template": "{editor} · 보기 Tool"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) · Move tool$",
      "template": "{editor} · 이동 Tool"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) · Rotate tool$",
      "template": "{editor} · 회전 Tool"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) · Scale tool$",
      "template": "{editor} · 크기 Tool"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) camera · top$",
      "template": "{editor} 카메라 · 위"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) camera · front$",
      "template": "{editor} 카메라 · 앞"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) camera · right$",
      "template": "{editor} 카메라 · 오른쪽"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) camera · iso$",
      "template": "{editor} 카메라 · ISO"
    },
    {
      "source": "^(?<name>.+) created in (?<editor>Editor [AB](?: · .+)?) and mirrored$",
      "template": "{name}이(가) {editor}에서 생성되어 동기화됨"
    },
    {
      "source": "^(?<name>.+) duplicated in (?<editor>Editor [AB](?: · .+)?) and mirrored$",
      "template": "{name}이(가) {editor}에서 복제되어 동기화됨"
    },
    {
      "source": "^(?<name>.+) deleted in (?<editor>Editor [AB](?: · .+)?) and mirrored$",
      "template": "{name}이(가) {editor}에서 삭제되어 동기화됨"
    },
    {
      "source": "^(?<name>.+) locked by (?<editor>Editor [AB](?: · .+)?)$",
      "template": "{name}을(를) {editor}에서 잠금"
    },
    {
      "source": "^(?<name>.+) lock released by (?<editor>Editor [AB](?: · .+)?)$",
      "template": "{name}의 잠금을 {editor}에서 해제함"
    },
    {
      "source": "^Locked · (?<owner>.+)$",
      "template": "잠김 · {owner}"
    },
    {
      "source": "^(?<editor>Editor [AB] · .+) interactive Scene view$",
      "template": "{editor} 인터랙티브 Scene 뷰"
    }
  ]
