    {
      "source": "^Locked · (?<editor>[AB])$",
      "template": "Lukustatud · {editor}"
    },
    {
      "source": "^Owner · Editor (?<editor>[AB])$",
      "template": "Omanik · Editor {editor}"
    },
    {
      "source": "^Type · (?<type>.+)$",
      "template": "Tüüp · {type}"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · [^·]+)?) handles · Global$",
      "template": "{editor} käepidemed · Globaalne"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · [^·]+)?) handles · Local$",
      "template": "{editor} käepidemed · Lokaalne"
    },
    {
      "source": "^(?<name>.+) Transform mirrored from (?<editor>Editor [AB](?: · .+)?)$",
      "template": "{name} Transform peegeldatud asukohast {editor}"
    },
    {
      "source": "^(?<name>.+) (?<property>position|rotation|scale) edited in (?<editor>Editor [AB](?: · .+)?)$",
      "template": "{name} {property} muudetud asukohas {editor}",
      "mapGroups": {
        "property": "property"
      }
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) selected (?<name>.+)$",
      "template": "{editor} valis {name}"
    },
    {
