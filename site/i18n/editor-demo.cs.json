    {
      "source": "^Locked · (?<owner>.+)$",
      "template": "Uzamčeno · {owner}"
    },
    {
      "source": "^(?<editor>Editor [AB] · .+) interactive Scene view$",
      "template": "Interaktivní Scene pohled {editor}"
    }
  ]
