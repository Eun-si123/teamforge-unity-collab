  "patterns": [
    {
      "source": "^Editor A ↔ Editor B · Cube X (?<value>[-.0-9]+) · (?<owner>.+)$",
      "template": "Editor A ↔ Editor B · Cube X {value} · {owner}",
      "mapGroups": {
        "owner": "mirrorOwner"
      }
    },
    {
      "source": "^Locked · (?<editor>[AB])$",
      "template": "Uzamčeno · {editor}"
    },
    {
      "source": "^Owner · Editor (?<editor>[AB])$",
      "template": "Vlastník · Editor {editor}"
    },
    {
      "source": "^Type · (?<type>.+)$",
      "template": "Typ · {type}"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · [^·]+)?) handles · Global$",
      "template": "{editor} úchyty · Globální"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · [^·]+)?) handles · Local$",
      "template": "{editor} úchyty · Lokální"
    },
    {
      "source": "^(?<name>.+) Transform mirrored from (?<editor>Editor [AB](?: · .+)?)$",
      "template": "Transform objektu {name} zrcadlen z {editor}"
    },
    {
      "source": "^(?<name>.+) (?<property>position|rotation|scale) edited in (?<editor>Editor [AB](?: · .+)?)$",
      "template": "{property} objektu {name} upravena v {editor}",
      "mapGroups": {
        "property": "property"
      }
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) selected (?<name>.+)$",
      "template": "{editor} vybral {name}"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) cleared selection$",
      "template": "{editor} zrušil výběr"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) · View tool$",
      "template": "{editor} · Nástroj zobrazení"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) · Move tool$",
      "template": "{editor} · Nástroj přesunu"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) · Rotate tool$",
      "template": "{editor} · Nástroj rotace"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) · Scale tool$",
      "template": "{editor} · Nástroj měřítka"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) camera · top$",
      "template": "{editor} kamera · shora"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) camera · front$",
      "template": "{editor} kamera · zepředu"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) camera · right$",
      "template": "{editor} kamera · zprava"
    },
    {
      "source": "^(?<editor>Editor [AB](?: · .+)?) camera · iso$",
      "template": "{editor} kamera · izometricky"
    },
    {
      "source": "^(?<name>.+) created in (?<editor>Editor [AB](?: · .+)?) and mirrored$",
      "template": "{name} vytvořen v {editor} a zrcadlen"
    },
    {
      "source": "^(?<name>.+) duplicated in (?<editor>Editor [AB](?: · .+)?) and mirrored$",
      "template": "{name} duplikován v {editor} a zrcadlen"
    },
    {
      "source": "^(?<name>.+) deleted in (?<editor>Editor [AB](?: · .+)?) and mirrored$",
      "template": "{name} smazán v {editor} a zrcadlen"
