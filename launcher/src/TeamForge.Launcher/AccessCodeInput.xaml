<UserControl x:Class="TeamForge.Launcher.AccessCodeInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Input_Loaded" Unloaded="Input_Unloaded"
             IsEnabledChanged="Input_IsEnabledChanged" IsVisibleChanged="Input_IsVisibleChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <PasswordBox x:Name="MaskedCodeBox" Grid.Column="0" Padding="7" MaxLength="8192"
                     AutomationProperties.Name="Access code"
                     PasswordChanged="MaskedCode_Changed" />
        <TextBox x:Name="RevealedCodeBox" Grid.Column="0" Padding="7" MaxLength="8192"
                 Visibility="Collapsed" AutomationProperties.Name="Access code (visible)"
                 TextChanged="RevealedCode_Changed" />
        <ToggleButton x:Name="RevealCodeButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,5"
                      Content="Show" AutomationProperties.Name="Show access code"
                      Checked="RevealCode_Changed" Unchecked="RevealCode_Changed" />
        <Button x:Name="ClearCodeButton" Grid.Column="2" Margin="6,0,0,0" Padding="10,5"
                Content="Clear" IsEnabled="False" AutomationProperties.Name="Clear access code"
                Click="ClearCode_Click" />
    </Grid>
</UserControl>
