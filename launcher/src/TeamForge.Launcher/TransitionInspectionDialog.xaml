<Window x:Class="TeamForge.Launcher.TransitionInspectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspect saved project recovery" Width="620" SizeToContent="Height"
        MaxHeight="760" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Inspect saved project recovery" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,12" TextWrapping="Wrap"
                       Text="Save and close Unity, and stop other project writers first. Paste the exact inspection request provided by your Host. The request is not signed authorization; this check does not change project files."/>
            <TextBox x:Name="RequestBox" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096"
                     Height="150" VerticalScrollBarVisibility="Auto"/>
            <CheckBox x:Name="StoppedCheckBox" Content="I saved and closed Unity and stopped other project writers."
                      Margin="0,12,0,0"/>
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#A12622" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Inspect saved files" Padding="12,5" Click="Inspect_Click" IsDefault="True"/>
                <Button Content="Cancel" Padding="12,5" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
