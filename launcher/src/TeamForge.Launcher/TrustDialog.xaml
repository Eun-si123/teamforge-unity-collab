<Window x:Class="TeamForge.Launcher.TrustDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trust this TeamForge project?"
        SizeToContent="WidthAndHeight"
        MaxWidth="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Labels and untrusted values must occupy separate controls even
             when a Project name contains spaces that cause line wrapping. -->
        <DataTemplate x:Key="FriendlyFieldTemplate">
            <Grid Margin="0,2,0,2" Width="610">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                           FlowDirection="LeftToRight" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedFieldTemplate">
            <Grid Margin="0,2,0,2" Width="590">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                         BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" FlowDirection="LeftToRight" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="Confirm the project publisher" />
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <ItemsControl x:Name="FriendlyFields" ItemTemplate="{StaticResource FriendlyFieldTemplate}" />
            <TextBlock x:Name="WarningText" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="610"
                       Visibility="Collapsed" />
            <TextBlock Margin="0,10,0,0" Text="Only continue if this is the project you expected from the host." TextWrapping="Wrap" />
        </StackPanel>
        <Expander Grid.Row="2" Header="Advanced fingerprint details" Margin="0,14,0,14">
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AdvancedFields" ItemTemplate="{StaticResource AdvancedFieldTemplate}" />
            </ScrollViewer>
        </Expander>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Trust and continue" IsDefault="True" Click="Trust_Click" />
        </StackPanel>
    </Grid>
</Window>
