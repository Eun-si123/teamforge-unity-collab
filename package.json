{
  "name": "unity-teamforge-workspace",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.23.2 <23 || >=24.18.1 <25"
  },
  "workspaces": [
    "server",
    "project-peer"
  ],
  "scripts": {
    "install:server": "npm --prefix server ci --ignore-scripts --workspaces=false",
    "install:peer": "npm --prefix project-peer ci --ignore-scripts --workspaces=false",
    "install:all": "npm run install:server && npm run install:peer",
    "preflight": "node project-peer/src/preflight-cli.mjs inspect",
    "repair:dependencies": "node project-peer/src/preflight-cli.mjs repair-dependencies --confirm-repair",
    "start": "npm --prefix server start",
    "test": "npm run test:agent-queue && npm run test:field-two-pc && npm --prefix server test && npm --prefix project-peer test && npm run validate:workflows && npm run validate:docs && npm run test:published-candidate && npm run validate:published-candidate && npm run test:maintainability && npm run validate:engineering && npm run testlab:validate && npm run validate",
    "smoke": "npm --prefix server run smoke && npm --prefix project-peer run smoke",
    "testlab": "node scripts/test-lab.mjs",
    "test:field-two-pc": "node --test scripts/field-two-pc.test.mjs",
    "test:field-realtime": "node --test scripts/field-realtime-two-pc.test.mjs scripts/field-realtime-guest-frame.test.mjs",
    "testlab:validate": "node scripts/test-lab.mjs validate",
    "classify:change": "node scripts/classify-change.mjs",
    "validate": "node scripts/validate-public-source.mjs",
    "validate:workflows": "node --test scripts/validate-workflows.test.mjs && node scripts/validate-workflows.mjs",
    "validate:docs": "node scripts/validate-documentation.mjs",
    "test:published-candidate": "node --test scripts/validate-published-candidate.test.mjs",
    "validate:published-candidate": "node scripts/validate-published-candidate.mjs",
    "validate:published-candidate:live": "node scripts/validate-published-candidate.mjs --live",
    "validate:engineering": "node scripts/validate-engineering.mjs",
    "validate:release": "node scripts/validate-repository.mjs",
    "dev": "node scripts/preview-site.mjs",
    "test:maintainability": "node --test scripts/review-maintainability.test.mjs",
    "review:maintainability": "node scripts/review-maintainability.mjs",
    "agent:queue": "node scripts/agent-workqueue.mjs",
    "test:agent-queue": "node --test scripts/agent-workqueue.test.mjs"
  },
  "license": "AGPL-3.0-only"
}
